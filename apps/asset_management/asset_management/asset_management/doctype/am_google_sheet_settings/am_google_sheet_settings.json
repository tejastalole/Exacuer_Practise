 "fields": [
  {
   "default": "0",
   "description": "Connects ERPNext to the Google Sheet. The sheet's Status column (Pending / Draft / Submitted / Cancelled, empty means Draft) decides what happens to each row's AM Stock Entry.",
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled"
  },
  {
   "depends_on": "enabled",
   "description": "Apps Script Web App URL (Deploy \u2192 New deployment \u2192 Web app), ending in /exec.",
   "fieldname": "web_app_url",
   "fieldtype": "Data",
   "label": "Web App URL",
   "mandatory_depends_on": "enabled",
   "options": "URL"
  },
  {
   "depends_on": "enabled",
   "description": "Same value as the SYNC_TOKEN Script Property in the Apps Script project.",
   "fieldname": "sync_token",
   "fieldtype": "Password",
   "label": "Sync Token",
   "mandatory_depends_on": "enabled"
  },
  {
   "default": "1",
   "depends_on": "enabled",
   "description": "Sync in the background every Sync Interval, so clicking Sync Now is not needed. Requires bench (scheduler and worker) to be running. Can't be used together with Daily Sync.",
   "fieldname": "auto_sync",
   "fieldtype": "Check",
   "label": "Auto Sync"
  },
  {
   "default": "60",
